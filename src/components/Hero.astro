---
import { facts } from '../data/site';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <img class="hero__mark" src="/images/logo.png" width="120" height="120" alt="AndrewInUA logo" />
    <p class="hero__hi">Hey, I'm Andrew!</p>
    <h1>An independent Solana validator from Ukraine.</h1>
    <p class="lede hero__lede">
      I care about decentralization, and about connecting people: across languages, and across this ecosystem.
      If you stake your SOL with this node, you support not just performance, but the purpose.
    </p>
    <div class="hero__actions">
      <a class="button button--gold" href="#delegate">Stake SOL with me</a>
      <a class="button button--ghost" href="#about">Read my story</a>
    </div>
    <p class="hero__facts">
      Independent validator on Solana mainnet since {facts.mainnetSince}, in the Solana Foundation Delegation Program.
      {facts.commission} commission, {facts.mevCommission} MEV commission.
    </p>
  </div>
</section>

<style>
  /* Vertically centred in the first screen: breathes on tall displays, still fits
     a 700px-tall laptop viewport with the buttons visible. */
  .hero {
    min-height: min(calc(100svh - 4.25rem), 920px);
    display: flex;
    align-items: center;
    padding-block: clamp(2.5rem, 7vh, 6rem) clamp(3rem, 8vh, 6rem);
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(47, 197, 180, 0.12), transparent 70%),
      var(--navy-800);
  }

  .hero__inner {
    width: min(100% - 2 * var(--gutter), var(--container));
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 50rem;
  }

  .hero__mark {
    width: clamp(96px, 14vh, 132px);
    margin-bottom: 1.5rem;
  }

  .hero__hi {
    font-size: 1.08rem;
    color: var(--ink-2);
    margin-bottom: 0.85rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 4.8vw, 3.6rem);
    max-width: 20ch;
    margin-bottom: 1.15rem;
  }

  .hero__lede {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    max-width: 36rem;
    margin-bottom: 1.85rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.25rem;
  }

  .hero__facts {
    max-width: 38rem;
    color: var(--ink-3);
    font-size: 0.93rem;
    line-height: 1.5;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
</style>
