---
import { site, links, keys } from '../data/site';

const contacts = [
  { href: links.x, label: 'X (Twitter)', handle: '@Andrew_In_UA' },
  { href: links.telegram, label: 'Telegram', handle: '@AndrewInUA' },
  { href: links.github, label: 'GitHub', handle: 'AndrewInUA' },
  { href: `mailto:${site.email}`, label: 'Email', handle: site.email },
  { href: links.linkedin, label: 'LinkedIn', handle: 'Andrii Vasyliuk' },
  { href: links.colosseum, label: 'Colosseum', handle: 'AndrewInUA' },
  { href: links.superteamEarn, label: 'Superteam Earn', handle: 'AndrewInUA' },
];

const year = new Date().getFullYear();
---

<footer class="footer section--deep" id="contact">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__about">
        <a class="footer__brand" href="#top">
          <img src="/images/logo-160.png" width="48" height="48" alt="" />
          <span>{site.name}</span>
        </a>
        <p>An independent Solana validator from Ukraine, dedicated to decentralization and values. Say hello — questions about staking are always welcome.</p>
      </div>

      <div>
        <h3 class="footer__title">Contact</h3>
        <ul class="contacts">
          {contacts.map((c) => (
            <li>
              <span class="contacts__label">{c.label}</span>
              <a href={c.href} target={c.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">{c.handle}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="footer__title">Validator</h3>
        <p class="footer__key"><span class="muted">Vote account</span><br /><code>{keys.vote}</code></p>
        <p class="footer__key"><span class="muted">Identity</span><br /><code>{keys.identity}</code></p>
      </div>
    </div>

    <p class="footer__legal">© {year} {site.name}. Staking involves risk; nothing on this site is financial advice.</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3rem, 7vw, 5rem) 2rem;
    border-top: 1px solid var(--line);
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }

  .footer__brand img {
    border-radius: 50%;
  }

  .footer__about p {
    color: var(--ink-2);
    max-width: 30rem;
  }

  .footer__title {
    font-family: var(--font-text);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-3);
    margin-bottom: 0.9rem;
  }

  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .contacts li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.5rem;
    font-size: 0.97rem;
  }

  .contacts__label {
    color: var(--ink-3);
  }

  .contacts a {
    word-break: break-all;
  }

  .footer__key {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .footer__key code {
    font-size: 0.8rem;
    word-break: break-all;
    color: var(--ink-2);
  }

  .footer__legal {
    color: var(--ink-3);
    font-size: 0.9rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 860px) {
    .footer__grid {
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
