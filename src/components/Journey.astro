---
import { timeline } from '../data/site';
---

<section class="section section--deep" id="about">
  <div class="container">
    <div class="story">
      <div class="story__text">
        <h2>My journey in Solana</h2>
        <p class="lede">I didn't come to Solana as a developer. My background is journalism and communications: writing, and getting people to understand each other.</p>
        <p>When the full-scale russian invasion of Ukraine started, I wanted to build something that would keep working while a lot around me wasn't. Solana was where that made sense to me. There was a lot to learn, and I knew the way through would be hard. It always is.</p>
        <p>So I launched a testnet validator in March 2022. At first I was a bit scared, because it was a completely new field for me, so I started learning hard. Testnet taught me a lot. By the time I was approved for mainnet in August 2023, I had enough behind me to keep going.</p>
        <p>Over time it grew past being just a node. I made guides people could actually follow, and I became part of a strong community.</p>
        <p>The validator is still running, and so am I. Here it is, one date at a time:</p>
      </div>
      <figure class="story__figure">
        <picture>
          <source srcset="/images/andrii-solana-summit-2026-480.webp 480w, /images/andrii-solana-summit-2026.webp 1200w" sizes="(min-width: 900px) 360px, 90vw" type="image/webp" />
          <img src="/images/andrii-solana-summit-2026.jpg" width="1200" height="1393" alt="Andrii in the main hall of Solana Summit Serbia in Belgrade, August 2026" loading="lazy" />
        </picture>
        <figcaption>Solana Summit Serbia, Belgrade, August 2026. My first Solana conference in person.</figcaption>
      </figure>
    </div>

    <div class="timeline__head" id="timeline">
      <p class="timeline__label">AndrewInUA validator timeline</p>
      <h3 class="timeline__title">From the first testnet node in March 2022 to today</h3>
    </div>

    <ol class="timeline" aria-label="Timeline">
      {timeline.map((group) => (
        <li class="timeline__year">
          <h3 class="timeline__year-label">{group.year}</h3>
          <ol class="timeline__items">
            {group.items.map((m) => (
              <li class:list={['milestone', { 'milestone--highlight': m.highlight, 'milestone--banner': m.image?.kind === 'banner' }]}>
                {m.image && m.image.kind !== 'banner' && (
                  <img class:list={['milestone__img', `milestone__img--${m.image.kind ?? 'logo'}`]} src={m.image.src} alt={m.image.alt} loading="lazy" />
                )}
                <div class="milestone__body">
                  {m.image && m.image.kind === 'banner' && <img class="milestone__banner" src={m.image.src} alt={m.image.alt} width="1200" height="400" loading="lazy" />}
                  <p class="milestone__date">{m.date}</p>
                  <p class="milestone__title">{m.title}</p>
                  {m.detail && <p class="milestone__detail">{m.detail}</p>}
                  {m.link && (
                    <p class="milestone__link">
                      <a href={m.link.href} target="_blank" rel="noopener">{m.link.label}</a>
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .story {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .story__text {
    max-width: var(--measure);
  }

  .story__text h2 {
    margin-bottom: 1rem;
  }

  .story__text .lede {
    margin-bottom: 1.25rem;
  }

  .story__text p:not(.lede) {
    color: var(--ink-2);
  }

  .story__figure {
    margin: 0;
    max-width: 360px;
  }

  .story__figure img {
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 1200 / 1393;
    object-fit: cover;
  }

  .story__figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.92rem;
    color: var(--ink-3);
    line-height: 1.45;
  }

  @media (min-width: 900px) {
    .story {
      grid-template-columns: minmax(0, 1fr) 360px;
    }
    .story__figure {
      padding-top: 0.6rem;
    }
  }

  /* Timeline */
  .timeline__head {
    scroll-margin-top: 5rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .timeline__label {
    margin: 0 0 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .timeline__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--gold), rgba(249, 203, 32, 0.25));
  }

  .timeline__year {
    position: relative;
    padding-left: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .timeline__year::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--navy-900);
    border: 3px solid var(--gold);
    box-sizing: border-box;
  }

  .timeline__year-label {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  .timeline__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.4rem;
  }

  .milestone {
    max-width: var(--measure);
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .milestone__img--logo {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    border-radius: 12px;
    object-fit: contain;
    padding: 6px;
    background: rgba(255, 255, 255, 0.04);
  }

  .milestone__img--square {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    border-radius: 12px;
    object-fit: cover;
  }

  .milestone__img--photo {
    flex: 0 0 160px;
    width: 160px;
    height: 104px;
    border-radius: 10px;
    object-fit: cover;
  }

  .milestone__banner {
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 3 / 1;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 0.9rem;
  }

  .milestone--highlight {
    /* the text column keeps the normal measure; the card grows by the logo, gap and padding */
    max-width: calc(var(--measure) + 96px + 1rem + 2.5rem);
    padding: 1.25rem 1.25rem 1.35rem;
    border: 1px solid rgba(249, 203, 32, 0.45);
    border-radius: 12px;
    background: rgba(249, 203, 32, 0.05);
  }

  .milestone--highlight .milestone__date {
    color: var(--gold);
  }

  .milestone--highlight .milestone__img--logo,
  .milestone--highlight .milestone__img--square {
    flex-basis: 96px;
    width: 96px;
    height: 96px;
  }

  @media (max-width: 600px) {
    .milestone__img--square {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    border-radius: 12px;
    object-fit: cover;
  }

  .milestone__img--photo {
      flex-basis: 96px;
      width: 96px;
      height: 96px;
    }
  }

  .milestone p {
    margin: 0;
  }

  .milestone__date {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--teal);
    margin-bottom: 0.15rem;
  }

  .milestone__title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .milestone__detail {
    color: var(--ink-2);
    margin-top: 0.25rem;
  }

  .milestone__link {
    margin-top: 0.35rem;
    font-size: 0.97rem;
  }

  @media (min-width: 900px) {
    .timeline::before {
      left: 8.4rem;
    }
    .timeline__year {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: 3rem;
      padding-left: 0;
    }
    .timeline__year::before {
      left: 7.95rem;
    }
    .timeline__year-label {
      text-align: right;
      margin-bottom: 0;
      padding-top: 0.1rem;
    }
  }
</style>
